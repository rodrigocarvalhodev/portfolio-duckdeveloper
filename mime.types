types {
    image/jpeg        jpg jpeg;
    image/png         png;
    image/gif         gif;

    application/pdf   pdf;
    application/msword doc docx;
    application/vnd.ms-excel xls xlsx;
    application/vnd.ms-powerpoint ppt pptx;

    audio/mpeg        mp3;
    audio/wav         wav;

    video/mp4         mp4;
    video/quicktime   mov;

    text/plain        txt;
    text/html         html htm shtml;
    text/css          css;
    application/javascript js
    application/json  json
    application/zip   zip;
    text/xml          xml;
}